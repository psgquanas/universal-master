{
  "expo": {
    "name": "Universal Chat",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.chatapp.bhado"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.chatapp.bhado"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Universal Chat to access your contacts to find friends already using the app."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Universal Chat to access your camera to take photos and videos.",
          "microphonePermission": "Allow Universal Chat to access your microphone to record voice messages.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Universal Chat to access your photos and videos to share media.",
          "savePhotosPermission": "Allow Universal Chat to save received photos to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Universal Chat to choose a profile photo or post image.",
          "cameraPermission": "Allow Universal Chat to take a profile photo or post image."
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "defaultChannel": "messages",
          "color": "#4361EE"
        }
      ],
      "expo-web-browser",
      "expo-asset",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bcc83bd4-dc88-4cfd-a90e-6eb2eda41bb3"
      }
    }
  }
}
